<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lilara.Head</RootNamespace>
    <AssemblyName>lilara-head</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <!-- ⚠️ 前端是**零构建**的（用户裁定）：没有打包步骤，`wwwroot/` 就是最终产物。
         所以只需要一句话把它**抄到输出目录**——`WebApplicationOptions.WebRootPath`
         是相对 **content root**（= `AppContext.BaseDirectory`）解析的，
         不抄过去就 404（实测踩过）。 -->
    <Content Include="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
