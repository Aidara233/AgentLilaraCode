<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lilara.Core</RootNamespace>
    <AssemblyName>Lilara.Core</AssemblyName>
    <PackageId>Lilara.Core</PackageId>
    <Version>0.1.0</Version>
    <PackageVersion>$(Version)</PackageVersion>
    <Authors>Agent Lilara</Authors>
    <Description>Reusable Agent Lilara execution and context kernel.</Description>
    <PackageTags>agent;kernel;llm</PackageTags>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.51.0" />
  </ItemGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Lilara.Core.Tests" />
  </ItemGroup>
</Project>
